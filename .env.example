# =============================================================================
# Cativa — variáveis de ambiente (modelo)
# =============================================================================
# Copie este arquivo para `.env` e preencha. Em ambientes Lovable Cloud,
# o `.env` é gerenciado automaticamente — você NÃO precisa editar manualmente.
#
# Em hospedagem própria (VPS / Vercel / Netlify / Nginx + qualquer Supabase):
#   1. Suba um Supabase (cloud ou self-hosted).
#   2. Aplique as migrations em supabase/migrations/.
#   3. Preencha as variáveis abaixo com os valores do seu projeto.
#
# Apenas chaves PUBLICÁVEIS (anon/publishable) ficam no client. NUNCA exponha
# o service_role no front-end. Secrets sensíveis vão em edge functions/server.
# =============================================================================

# URL base do projeto Supabase (ou seu auto-host)
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"

# Chave PUBLICÁVEL (anon) — pode aparecer no client
VITE_SUPABASE_PUBLISHABLE_KEY="eyJxxxx.publishable.anon.key.xxxx"

# (Opcional) Identificador do projeto
VITE_SUPABASE_PROJECT_ID="seu-project-ref"

# =============================================================================
# QA local / Playwright (não vão para produção)
# =============================================================================
# Usuário seed para validar fluxos autenticados no ambiente apontado acima.
# Use preferencialmente em `.env.local`.
# E2E_USER="visual-test@cativa.local"
# E2E_PASS="senha-forte"
#
# Opcional: apontar testes E2E para staging/produção em vez de localhost.
# E2E_BASE_URL="http://localhost:8080"

# =============================================================================
# Secrets que VIVEM NO BACKEND (edge functions / server) — nunca no client
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY=...
# LOVABLE_API_KEY=...        # acesso ao gateway de IA
# SUPABASE_DB_URL=postgres://...   # acesso direto ao banco para scripts
