# Variáveis do Supabase (substitua pelos valores do seu projeto)
VITE_SUPABASE_URL="https://uqskxftzmjsumykpkwus.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_PROJECT_ID="uqskxftzmjsumykpkwus"

# Observabilidade (opcional — deixe vazio para desabilitar Sentry)
# VITE_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Debug em produção (opcional — padrão: apenas import.meta.env.DEV)
# VITE_ENABLE_DEBUG="true"

# Secret exclusivo do backend/Edge Function retention-advisor.
# Nunca prefixe com VITE_ nem exponha esta chave no bundle do navegador.
# Configure no Supabase com: supabase secrets set TYPESAFE_API_KEY=...
# TYPESAFE_API_KEY="ts_..."

# Origens permitidas para Edge Functions, separadas por vírgula (recomendado em produção).
# ALLOWED_ORIGINS="https://app.exemplo.com,https://admin.exemplo.com"

# Política operacional do Jev (opcionais; os valores abaixo são os padrões).
# RETENTION_ACTION_CONFIDENCE_THRESHOLD="0.60"
# RETENTION_EVIDENCE_THRESHOLD="0.65"
# RETENTION_DAILY_TENANT_LIMIT="200"
